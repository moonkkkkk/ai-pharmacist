.container {
  padding: 24rpx;
}

.header {
  background: #ffffff;
  border-radius: 16rpx;
  border-top: 4rpx solid #2BB3A3;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.header-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #333333;
}

.header-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.stats-row {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding: 30rpx 0;
  margin-bottom: 24rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
}

.stat-num.ok { color: #2BB3A3; }
.stat-num.miss { color: #e64340; }

.stat-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999999;
}

.report-block {
  background: #E6F5F2;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.report-block.empty {
  background: #f7f7f7;
}

.report-title {
  font-size: 24rpx;
  color: #2BB3A3;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.report-text {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.7;
}

.report-text.loading {
  color: #999999;
}

.hint {
  text-align: center;
  font-size: 24rpx;
  color: #bbbbbb;
  padding: 12rpx 0;
}
