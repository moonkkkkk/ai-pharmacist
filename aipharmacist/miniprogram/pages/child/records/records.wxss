.container {
  padding: 24rpx;
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
  font-size: 28rpx;
  color: #999999;
}

.family-tabs {
  display: flex;
  margin-bottom: 20rpx;
}

.tab {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background: #f0f0f0;
  color: #666666;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.tab.active {
  background: #07c160;
  color: #ffffff;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 10rpx;
}

.arrow {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #666666;
}

.month-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.heat-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.week-row {
  display: flex;
  margin-bottom: 8rpx;
}

.week-cell {
  width: 14.285%;
  text-align: center;
  font-size: 22rpx;
  color: #999999;
}

.dot-grid {
  display: flex;
  flex-wrap: wrap;
}

.dot-cell {
  width: 14.285%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
}

.dot.full { background: #07c160; }
.dot.part { background: #ff9f00; }
.dot.miss { background: #e64340; }
.dot.none { background: #e8e8e8; color: #999999; }
.dot.blank { background: transparent; }

.legend {
  display: flex;
  margin-top: 16rpx;
  justify-content: center;
}

.lg {
  display: flex;
  align-items: center;
  margin: 0 16rpx;
  font-size: 22rpx;
  color: #999999;
}

.lg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.lg-dot.full { background: #07c160; }
.lg-dot.part { background: #ff9f00; }
.lg-dot.miss { background: #e64340; }
.lg-dot.none { background: #e8e8e8; }

.stats {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #333333;
}

.section-title {
  margin-top: 32rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.empty-sub {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  font-size: 28rpx;
  color: #07c160;
}

.missed-list {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.missed-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.missed-item:last-child {
  border-bottom: none;
}

.missed-bar {
  width: 6rpx;
  height: 48rpx;
  border-radius: 3rpx;
  background: #fa5151;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.missed-info {
  flex: 1;
}

.missed-drug {
  font-size: 28rpx;
  color: #333333;
}

.missed-time {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #fa5151;
}
