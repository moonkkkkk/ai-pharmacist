.container {
  padding: 30rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.info {
  flex: 1;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.role {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #888888;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.cell-label {
  font-size: 30rpx;
  color: #333333;
}

.cell-value {
  font-size: 28rpx;
  color: #999999;
}

.logout-btn {
  margin-top: 40rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #fa5151;
  font-size: 32rpx;
}

.tip {
  margin-top: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #bbbbbb;
}
