.container {
  padding: 30rpx;
}

.form-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.label {
  font-size: 34rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.input {
  font-size: 36rpx;
  color: #333333;
  height: 60rpx;
}

.picker-value {
  font-size: 36rpx;
  color: #333333;
}

.radio-item {
  display: inline-flex;
  align-items: center;
  margin-right: 50rpx;
  font-size: 36rpx;
  color: #333333;
}

.stepper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stepper-btn {
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 50rpx;
  color: #2BB3A3;
  background: #E6F5F2;
  border-radius: 50%;
}

.stepper-mid {
  display: flex;
  align-items: center;
}

.stepper-label {
  font-size: 34rpx;
  color: #666666;
}

.stepper-input {
  width: 120rpx;
  height: 80rpx;
  margin: 0 12rpx;
  text-align: center;
  font-size: 42rpx;
  font-weight: 700;
  color: #2BB3A3;
  background: #E6F5F2;
  border-radius: 12rpx;
}

.stepper-hint {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #aaaaaa;
}

.save-btn {
  margin-top: 40rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: #2BB3A3;
  color: #ffffff;
  font-size: 38rpx;
}
