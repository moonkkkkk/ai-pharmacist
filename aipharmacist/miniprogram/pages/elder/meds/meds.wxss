.container {
  padding: 30rpx;
  padding-bottom: 40rpx;
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
  font-size: 36rpx;
  color: #999999;
}

/* 子女：成员卡片 */
.member-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.member-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.family-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #E6F5F2;
  color: #2BB3A3;
  flex-shrink: 0;
}

.member-title {
  flex: 1;
  margin-left: 20rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.member-count {
  font-size: 30rpx;
  color: #999999;
}

.member-meds {
  margin-top: 16rpx;
}

.member-med {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #F0F0F0;
}

.member-med-left {
  flex: 1;
  margin-right: 16rpx;
}

.member-med-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.member-med-meta {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #999999;
}

.member-toggle {
  text-align: center;
  padding: 16rpx 0 4rpx;
  font-size: 30rpx;
  color: #2BB3A3;
}

/* 老人端药品卡片 */
.med-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 34rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.med-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.med-name {
  font-size: 42rpx;
  font-weight: 700;
  color: #1A1A1A;
  flex: 1;
}

.med-actions {
  display: flex;
  align-items: center;
}

.action {
  font-size: 30rpx;
  color: #2BB3A3;
  padding: 6rpx 16rpx;
  margin-left: 8rpx;
  border-radius: 10rpx;
  background: #E6F5F2;
}

.action.danger {
  color: #E64340;
  background: #FDECEC;
}

.med-meta {
  margin-top: 16rpx;
  font-size: 34rpx;
  color: #666666;
}

.med-category {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #2BB3A3;
  background: #E6F5F2;
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
}

.add-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  background: #2BB3A3;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 24rpx rgba(43, 179, 163, 0.25);
  margin-top: 8rpx;
}
