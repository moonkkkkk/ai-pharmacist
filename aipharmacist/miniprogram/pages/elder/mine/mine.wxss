.container {
  padding: 30rpx;
}

.profile-card {
  position: relative;              /* 给头像绝对定位做参照 */
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;            /* 上下左右内边距 */
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  min-height: 120rpx;              /* 保证卡片高度够放头像 */
}

.avatar-btn {
  position: absolute;              /* 头像脱离文档流，贴最左 */
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
}

.avatar-btn::after {
  border: none;                    /* 去掉按钮默认边框 */
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #2BB3A3;
  color: #ffffff;
  font-size: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;             /* 昵称和角色水平居中 */
  text-align: center;
  padding-left: 120rpx;            /* 给左侧头像留出空间，避免文字被遮住 */
}

.name-input {
  font-size: 46rpx;
  font-weight: 600;
  color: #333333;
  height: 60rpx;
  width: 100%;
  text-align: center;              /* 输入框内文字居中 */
}

.role {
  margin-top: 8rpx;
  font-size: 32rpx;
  color: #999999;
  text-align: center;
}

.cell {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cell-label {
  font-size: 36rpx;
  color: #333333;
}

.cell-value {
  font-size: 34rpx;
  color: #2BB3A3;
}

.vip-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vip-card.on {
  background: linear-gradient(135deg, #E6F5F2, #D7EEE9);
}

.vip-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.vip-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #EEEEEE;
  flex-shrink: 0;
}

.vip-icon.on {
  background: #2BB3A3;
}

.vip-info {
  flex: 1;
}

.vip-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.vip-sub {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #999999;
}

.vip-tag {
  font-size: 30rpx;
  color: #ffffff;
  background: #2BB3A3;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  flex-shrink: 0;
}

.logout-btn {
  margin-top: 40rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #E64340;
  font-size: 36rpx;
}